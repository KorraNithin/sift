# Copy to .env (never commit real values). All have safe local defaults except JWT_SECRET in production.
PORT=4000
NODE_ENV=development
JWT_SECRET=
DB_PATH=
STORAGE_DIR=
COOKIE_SECURE=false
SEED_DEMO=false
# Optional: enables LLM-assisted JD extraction (falls back to rules when empty or on error)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
